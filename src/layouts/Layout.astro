---
import { site, settings } from '../../site.config.mjs';
import { copy } from '../content/home';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import sansFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import serifFont from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import italicFont from '@fontsource/newsreader/files/newsreader-latin-400-italic.woff2?url';
interface Props { title?: string; description?: string; notFound?: boolean; }
const { title = copy.title, description = copy.description, notFound = false } = Astro.props;
const legalLinks = [['Contact', settings.CONTACT_URL], ['Privacy', settings.PRIVACY_URL], ['Terms', settings.TERMS_URL]].filter(([, url]) => url);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {[sansFont,serifFont,italicFont].map(font=><link rel="preload" href={font} as="font" type="font/woff2" crossorigin="anonymous" />)}
    <meta name="theme-color" content="#f6f5ef" />
    <meta name="description" content={description} />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={site.siteUrl} />}
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bookkin" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={notFound ? site.absolute('404.html') : site.siteUrl} />
    <meta property="og:image" content={site.absolute('og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bookkin. Your books. Your kind of people. A quiet social library." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={site.absolute('og.png')} />
    <link rel="icon" type="image/png" href={site.asset('favicon.png')} />
    <link rel="apple-touch-icon" href={site.asset('bookkin-icon.png')} />
    <link rel="sitemap" href={site.absolute('sitemap-index.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="brand" href={site.base} aria-label="Bookkin home"><img src={site.asset('bookkin-icon.png')} width="34" height="34" alt="" /><span>Bookkin<span class="brand-dot">.</span></span></a>
        <div class="navigation-cluster"><nav aria-label="Main navigation">
          <a class="nav-secondary" data-nav-section="features" href={`${site.base}#features`}>Features</a>
          <a class="nav-secondary" data-nav-section="how-it-works" href={`${site.base}#how-it-works`}>How it works</a>
          <a class="nav-download" data-nav-section="download" href={`${site.base}#download`}>Download <Icon name="down" size={17} /></a>
        </nav>
        <details class="mobile-menu"><summary aria-label="Site menu"><span class="menu-glyph" aria-hidden="true"><span></span><span></span></span></summary><nav aria-label="Mobile navigation"><a href={`${site.base}#features`}>Inside Bookkin <Icon name="arrow" size={18} /></a><a href={`${site.base}#how-it-works`}>How it works <Icon name="arrow" size={18} /></a><a href={`${site.base}#faq`}>A few questions <Icon name="arrow" size={18} /></a>{settings.WEB_APP_URL&&<a href={settings.WEB_APP_URL}>Open web app <span aria-hidden="true">↗</span></a>}</nav></details>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <div class="footer-top">
        <a class="brand" href={site.base} aria-label="Bookkin home"><img src={site.asset('bookkin-icon.png')} width="32" height="32" alt="" /><span>Bookkin<span class="brand-dot">.</span></span></a>
        <p>A quiet social library.</p>
        <nav aria-label="Footer navigation">
          {settings.WEB_APP_URL && <a href={settings.WEB_APP_URL}>Open web app <span aria-hidden="true">↗</span></a>}
          {legalLinks.map(([label, url]) => <a href={url}>{label}</a>)}
          <a href={`${site.base}#faq`}>FAQ</a>
        </nav>
      </div>
      <div class="footer-bottom"><p>© {new Date().getUTCFullYear()} Bookkin</p><p>For the books. And the people behind them.</p><a href="#main">Back to top ↑</a></div>
    </footer>
  </body>
</html>
