---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import DownloadOption from '../components/DownloadOption.astro';
import { site, settings, downloads } from '../../site.config.mjs';
import { copy } from '../content/home';
import profile from '../assets/app-profile.png';
import people from '../assets/app-people.png';
import home from '../assets/app-home.png';
const anyDownload = !!(downloads.ios.url || downloads.android.url);
const bothSoon = !anyDownload;
const previewImages = [profile, people, home];
const previewAlts = ['Bookkin Profile with a personal bookshelf, favourite books and collections, using sample content.', 'Bookkin People showing readers and their favourite books, using sample content.', 'Bookkin Home with a community post about books, using sample content.'];
const platformAnswer = bothSoon ? copy.faqs[0].answer : `Bookkin is available on the web. ${downloads.ios.kind === 'soon' ? 'The iOS app is coming soon.' : downloads.ios.kind === 'beta' ? 'An iOS beta is available through TestFlight.' : 'The iOS app is available on the App Store.'} ${downloads.android.kind === 'soon' ? 'The Android app is coming soon.' : downloads.android.kind === 'apk' ? 'A signed Android release is available as a direct APK download.' : 'The Android app is available on Google Play.'} See the download section for current links.`;
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow"><span class="little-star" aria-hidden="true">✳</span>{copy.hero.eyebrow}</p>
      <h1 id="hero-heading">Your books.<br /><em>Your kind</em><br />of people.</h1>
      <p class="hero-description">{copy.hero.description}</p>
      <div class="hero-actions"><a class="button" href="#download">Get Bookkin <Icon name="arrow" /></a>{settings.WEB_APP_URL && <a class="text-link" href={settings.WEB_APP_URL}>Explore the web app <span aria-hidden="true">↗</span></a>}</div>
      <p class="availability">{bothSoon ? 'iOS & Android apps are coming soon. Explore the web app today.' : 'Find the current iOS and Android options below.'}</p>
    </div>
    <figure class="hero-visual">
      <div class="hero-stage">
        <span class="stage-note" aria-hidden="true">A little shelf.<br />A whole lot of you.</span>
        <div class="phone hero-phone">
          <Image src={profile} alt={previewAlts[0]} widths={[390, 780]} sizes="(max-width: 767px) 260px, 300px" width={390} format="webp" quality={88} loading="eager" fetchpriority="high" />
        </div>
        <span class="stage-index" aria-hidden="true">THE BOOKKIN LIBRARY — 001</span>
        <span class="stage-stamp" aria-hidden="true"><Icon name="book" size={26} /><span>Books bring<br />us together.</span></span>
      </div>
      <figcaption>Actual Bookkin interface with sample content.</figcaption>
    </figure>
  </section>

  <div class="intro-rule wrap"><span>YOUR READING LIFE, A LITTLE MORE CONNECTED</span><a href="#features" aria-label="Discover Bookkin’s features"><Icon name="down" size={20} /></a></div>

  <section id="features" class="features wrap" aria-labelledby="features-heading">
    <div class="section-intro"><p class="eyebrow">Room for what you love</p><h2 id="features-heading">Not just what you read.<br /><em>What brings you together.</em></h2><p>Some books become part of who we are.<br />Bookkin gives them a place to live — and a way to connect.</p></div>
    {copy.features.map((feature, index) => (
      <article class:list={['feature-row', `feature-${index + 1}`, { 'feature-reverse': index === 1 }]}>
        <figure class="feature-visual">
          <div class="feature-stage">
            <span class="feature-watermark" aria-hidden="true">{['Keep.', 'Discover.', 'Share.'][index]}</span>
            <div class="phone feature-phone"><Image src={previewImages[index]} alt={previewAlts[index]} widths={[390, 780]} sizes="(max-width: 767px) 252px, 280px" width={390} format="webp" quality={86} loading="lazy" /></div>
            <span class="feature-stage-label" aria-hidden="true">{['A collection of you', 'Find a shared favourite', 'Stories beyond the page'][index]}</span>
          </div>
          <figcaption>Actual Bookkin interface with sample content.</figcaption>
        </figure>
        <div class="feature-copy"><p class="eyebrow"><span class="feature-number">{feature.number}</span>{feature.label}</p><h3>{feature.title.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h3><p class="feature-description">{feature.text}</p><ul class="feature-details">{feature.details.map((detail) => <li><Icon name="check" size={17} /><span>{detail}</span></li>)}</ul></div>
      </article>
    ))}
  </section>

  <section id="how-it-works" class="how-section" aria-labelledby="how-heading">
    <div class="wrap"><div class="how-heading"><div><p class="eyebrow">A small beginning</p><h2 id="how-heading">Start with a book.<br /><em>See where it takes you.</em></h2></div><p>Your shelf doesn’t have to be impressive.<br />It just has to be yours.</p></div>
      <ol class="steps">{copy.steps.map((step, index) => <li><span class="step-number" aria-hidden="true">0{index + 1}</span><h3>{anyDownload && index === 0 ? 'Download. Settle in.' : step.title}</h3><p>{anyDownload && index === 0 ? 'Choose your platform below, download Bookkin, and create your account.' : step.text}</p></li>)}</ol>
    </div>
  </section>

  <section class="download-section wrap" aria-labelledby="download-heading">
    <div id="download" class="download-panel">
      <div class="download-copy"><img class="download-icon" src={site.asset('bookkin-icon.png')} width="58" height="58" alt="" loading="lazy" /><p class="eyebrow">Take your next chapter with you</p><h2 id="download-heading">A place for your books.<br /><em>And for you.</em></h2><p class="download-description">{bothSoon ? 'The mobile apps are on their way. In the meantime, your reading life has a home on the web.' : 'Pick your platform and make yourself at home. Your next good read might begin with someone else’s shelf.'}</p>
        <div class="platforms"><DownloadOption platform="iOS" option={downloads.ios} /><DownloadOption platform="Android" option={downloads.android} /></div>
        {settings.WEB_APP_URL && <a class="download-web-link" href={settings.WEB_APP_URL}>Open Bookkin on the web <Icon name="arrow" size={19} /></a>}
      </div>
      <aside class="qr-panel" aria-label="Open this page on your phone"><div class="qr-art"><img src={site.asset('download-qr.png')} alt="QR code linking to this website’s download section." width="180" height="180" loading="lazy" /></div><p class="qr-heading">Meet us on your phone.</p><p>Scan for the latest<br />download options.</p><a href={site.downloadUrl}>Open download page <span aria-hidden="true">↗</span></a></aside>
    </div>
  </section>

  <section id="faq" class="faq-section wrap" aria-labelledby="faq-heading"><div class="faq-intro"><p class="eyebrow">A few things to know</p><h2 id="faq-heading">Before you <br /><em>turn the page.</em></h2></div><div class="faq-list">{copy.faqs.map((faq) => <details><summary>{faq.question}<span class="faq-plus"><Icon name="plus" size={20} /></span></summary><div class="faq-answer"><p>{faq.platformStatus ? platformAnswer : faq.answer}</p>{faq.platformStatus && <a href="#download">See download options <span aria-hidden="true">↗</span></a>}</div></details>)}</div></section>
</Layout>
